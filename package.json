{
  "name": "@kt-ai-labs/workflow-miner",
  "version": "0.0.0",
  "private": true,
  "description": "Mine AI coding sessions for recurring workflow friction and turn it into actionable automation",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/providers/*"
  ],
  "scripts": {
    "build": "rimraf ./packages/providers/*/dist && tsc --build",
    "build:release": "npm run build",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "check": "tsc --build",
    "test": "vitest run --run",
    "coverage": "vitest run --coverage",
    "changeset:version": "changeset version && npm install && git add --all",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
